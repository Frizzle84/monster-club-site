ebfecb84f64a069897515042a44\":{\"link_created_at_min\":\"2026-03-03T22:00:00Z\"}}},\"is_device_based\":false,\"passed\":false},\"371023604\":{\"name\":\"371023604\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":27,\"id_type\":\"userID\",\"value\":{\"controls\":{\"connector_1e4f6a44acf14e3ca1d96672f8c945bc\":{\"sharepoint_allowed_sites\":{\"display_in_ui\":false,\"enforce\":false},\"sharepoint_site_access_policy\":{\"display_in_ui\":false,\"enforce\":false}},\"connector_5f3c8c41a1e54ad7a76272c89e2554fa\":{\"google_drive_allowed_domains\":{\"enforce\":false,\"display_in_ui\":false}},\"connector_4aaab2856305417b993eca9a216aaf6e\":{\"email_recipient_domains\":{\"enforce\":false,\"display_in_ui\":false}},\"connector_69c53ce437208190a51498354624deaf\":{\"email_recipient_domains\":{\"display_in_ui\":false,\"enforce\":false}},\"connector_2128aebfecb84f64a069897515042a44\":{\"email_recipient_domains\":{\"display_in_ui\":true,\"enforce\":true},\"gmail_recipient_domains\":{\"display_in_ui\":true,\"enforce\":true}},\"connector_69c68b8f7afc8190af51010f6bfe8fae\":{\"email_recipient_domains\":{\"display_in_ui\":false,\"enforce\":false}}}},\"is_device_based\":false,\"passed\":false},\"209658048\":{\"name\":\"209658048\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":15,\"id_type\":\"userID\",\"value\":{\"minimum_response_tokens\":200,\"minimum_response_length\":400},\"is_device_based\":false,\"passed\":false},\"3317473948\":{\"name\":\"3317473948\",\"rule_id\":\"2VVKrjIwc2VcBceUZhfkJB:100.00:3\",\"secondary_exposures\":[],\"version\":25,\"id_type\":\"userID\",\"value\":{\"default_max_polling_duration\":200,\"local_conversation_insert_fallback_disabled_system_hints\":[\"agent\"],\"default_interval\":5,\"model_slug_max_polling_durations\":{\"image_gen\":300,\"o3_pro\":1200,\"o1_pro\":1200},\"polling_fallback_on_message_insertion_error\":[{\"fallback_mode\":\"final_assistant_answer\"}],\"model_slug_intervals\":{\"image_gen\":10,\"gpt_4o\":2}},\"is_device_based\":false,\"passed\":true},\"944963740\":{\"name\":\"944963740\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":8,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"842715733\":{\"name\":\"842715733\",\"rule_id\":\"5Xs0JSzIURZ0gYR7k5O6bc\",\"secondary_exposures\":[],\"version\":15,\"id_type\":\"userID\",\"value\":{\"enabled\":false},\"is_device_based\":false,\"group_name\":\"control\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"111706139\":{\"name\":\"111706139\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"444232970\",\"gateValue\":\"false\",\"ruleID\":\"gbNhJYZt2LT0MMPpBwPnn\"}],\"version\":14,\"id_type\":\"userID\",\"value\":{\"enabled\":true,\"name\":\"microsoft\",\"tempDisabled\":false,\"kind\":\"social\",\"loginStrategy\":\"existing_user\"},\"is_device_based\":false,\"passed\":false},\"3119290944\":{\"name\":\"3119290944\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":5,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"365985288\":{\"name\":\"365985288\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":6,\"id_type\":\"stableID\",\"value\":{\"wayfinder\":[],\"maverick\":[],\"pioneer\":[],\"stratos\":[],\"trailblazer\":[],\"seeker\":[]},\"is_device_based\":true,\"passed\":false},\"635008376\":{\"name\":\"635008376\",\"rule_id\":\"1qXlgzd8O6lwp6u4B1uLvP:100.00:1-1qXlgxy6lOc25GW8ZTz8cN\",\"secondary_exposures\":[{\"gate\":\"3612242227\",\"gateValue\":\"false\",\"ruleID\":\"2Y3kdFl1HVF2xBzA7MH25u:2.00:1\"},{\"gate\":\"2831404950\",\"gateValue\":\"true\",\"ruleID\":\"qsULhPO4uqwoeOWdF6OcX\"}],\"version\":4,\"id_type\":\"userID\",\"value\":{\"show_see_all_plans_button\":\"enabled\"},\"is_device_based\":false,\"passed\":true},\"3553340571\":{\"name\":\"3553340571\",\"rule_id\":\"33JFuUmpC75eH8yhBvVavz:100.00:1-33JFuSHn9OVKnJ0